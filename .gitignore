# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
build/
dist/
*.egg-info/

# Editor and OS files
.idea/
.vscode/
.DS_Store

# Trial media and generated artifacts (curate public samples deliberately)
evaluation/runs/
demo/raw/
# Captured snapshots. These default to /mnt/data, but a stray --out must not
# push identifiable images into a public repository (see docs/HACKATHON.md).
snapshots/
**/snapshot.json
**/color.png
**/depth.png
# Motion-check runs. These also default to /mnt/data, but motion.json is not a
# name .gitignore would otherwise catch, and a run names the operator and spotter.
motion/
**/motion.json
**/standing-signature.json
*.bag
*.db3
*.mcap
